{
  "name": "@feugene/granum-engine-mini",
  "description": "Utility engine for @feugene/granum: a vendored fork of the UnoCSS core with preset-mini and extra rules, exposed as a GranumEngine instance with an explicit dialect and vocabulary fingerprint.",
  "version": "0.2.0",
  "license": "MIT",
  "author": {
    "name": "Evgeniy Fureev",
    "url": "https://github.com/efureev"
  },
  "homepage": "https://github.com/efureev/granum#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efureev/granum.git",
    "directory": "packages/granum-engine-mini"
  },
  "bugs": {
    "url": "https://github.com/efureev/granum/issues"
  },
  "keywords": [
    "granum",
    "unocss",
    "utility-css",
    "css-engine",
    "design-tokens",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "types": "./dist/types/src/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@feugene/granum": "^0.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@feugene/granum": "0.2.0",
    "@feugene/unocss-mini-extra-rules": "0.8.1",
    "@types/node": "^26.1.1",
    "@unocss/core": "66.7.5",
    "@unocss/extractor-arbitrary-variants": "66.7.5",
    "@unocss/preset-mini": "66.7.5",
    "@unocss/rule-utils": "66.7.5",
    "eslint": "^10.7.0",
    "typescript": "^6.0.3",
    "unocss": "66.7.5",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/copy-vendor-types.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "test": "vitest --config vitest.config.ts",
    "test:run": "vitest run --config vitest.config.ts",
    "vendor:unocss": "node scripts/vendor-unocss.mjs",
    "check:vendor": "node scripts/vendor-unocss.mjs && git diff --exit-code --stat -- src/vendor THIRD_PARTY_NOTICES.md"
  }
}
